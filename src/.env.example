APP_NAME="mini-RAG"
APP_VERSION="0.1"

MONGODB_URL="mongodb://admin:admin@localhost:27007"
MONGODB_DATABASE="mini-rag"

# ========================= LLM Config =========================
# Backends: GEMINI (default) | OPENAI | COHERE
GENERATION_BACKEND="GEMINI"
EMBEDDING_BACKEND="GEMINI"

GEMINI_API_KEY=""
OPENAI_API_KEY=""
OPENAI_API_URL=""
COHERE_API_KEY=""

# Defaults below match the GEMINI backend
GENERATION_MODEL_ID="gemini-2.5-flash"
# Gemini API embedding models (Developer API): gemini-embedding-001 | gemini-embedding-2
EMBEDDING_MODEL_ID="gemini-embedding-001"
EMBEDDING_MODEL_SIZE=768

INPUT_DAFAULT_MAX_CHARACTERS=1024
GENERATION_DAFAULT_MAX_TOKENS=1024
GENERATION_DAFAULT_TEMPERATURE=0.1

# ========================= Vector DB Config =========================
VECTOR_DB_BACKEND="QDRANT"
VECTOR_DB_PATH="qdrant_db"
VECTOR_DB_DISTANCE_METHOD="cosine"

# ========================= Template Configs =========================
# Bilingual app: Arabic (ar) and French (fr). Default is Arabic.
PRIMARY_LANG="ar"
DEFAULT_LANG="ar"

# ========================= Keycloak Auth =========================
KEYCLOAK_SERVER_URL="http://localhost:8080"
KEYCLOAK_REALM="rag-legall"
KEYCLOAK_CLIENT_ID="rag-legall-frontend"
# By default Keycloak puts "account" in the token audience. For production,
# add an Audience mapper on the client (e.g. "rag-legall-api") and update this.
KEYCLOAK_AUDIENCE="account"
